{
  "openapi": "3.1.0",
  "info": {
    "title": "CLPS Lunar Mission Browser API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Get Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites": {
      "get": {
        "summary": "List Sites",
        "operationId": "listSites",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SiteOut"
                  },
                  "type": "array",
                  "title": "Response Listsites"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites/custom": {
      "get": {
        "summary": "Get Custom Site",
        "description": "Canonical custom site (RF-17) for user coordinates: planetocentric \u00b0, east longitude.",
        "operationId": "createCustomSite",
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Latitude"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "title": "Longitude"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteOut"
                }
              }
            }
          },
          "422": {
            "description": "Coordinates outside the south polar region"
          }
        }
      }
    },
    "/api/sites/{site_id}": {
      "get": {
        "summary": "Get Site",
        "operationId": "getSite",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteOut"
                }
              }
            }
          },
          "404": {
            "description": "Unknown site id"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sites/{site_id}/terrain": {
      "get": {
        "summary": "Get Site Terrain",
        "operationId": "getSiteTerrain",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerrainPatchOut"
                }
              }
            }
          },
          "404": {
            "description": "Unknown site, or no terrain for it (custom sites never have)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/map": {
      "get": {
        "summary": "Get Pole Map",
        "operationId": "getPoleMap",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoleMapOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/map/hillshade.png": {
      "get": {
        "summary": "Get Pole Map Image",
        "operationId": "getPoleMapImage",
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Basemap not downloaded (run make fetch-basemap)"
          }
        }
      }
    },
    "/api/analysis": {
      "post": {
        "summary": "Analyze Scenario",
        "operationId": "analyzeScenario",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid scenario (sites, dates, step or height)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "site_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 2,
            "title": "Site Ids"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "step_minutes": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Step Minutes",
            "default": 60
          },
          "observer_height_m": {
            "type": "number",
            "minimum": 0.0,
            "title": "Observer Height M",
            "default": 2.0
          },
          "horizon": {
            "type": "string",
            "enum": [
              "terrain",
              "flat"
            ],
            "title": "Horizon",
            "default": "terrain"
          },
          "earth_min_clearance_deg": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Earth Min Clearance Deg",
            "default": 0.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "site_ids",
          "start",
          "end"
        ],
        "title": "AnalysisRequest"
      },
      "AnalysisResponse": {
        "properties": {
          "request": {
            "$ref": "#/components/schemas/AnalysisRequest"
          },
          "times": {
            "items": {
              "type": "string",
              "format": "date-time"
            },
            "type": "array",
            "title": "Times"
          },
          "sites": {
            "items": {
              "$ref": "#/components/schemas/SiteResult"
            },
            "type": "array",
            "title": "Sites"
          },
          "assumptions": {
            "items": {
              "$ref": "#/components/schemas/AssumptionOut"
            },
            "type": "array",
            "title": "Assumptions"
          },
          "data_sources": {
            "items": {
              "$ref": "#/components/schemas/DataSourceOut"
            },
            "type": "array",
            "title": "Data Sources"
          }
        },
        "type": "object",
        "required": [
          "request",
          "times",
          "sites",
          "assumptions",
          "data_sources"
        ],
        "title": "AnalysisResponse"
      },
      "AssumptionOut": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "value"
        ],
        "title": "AssumptionOut"
      },
      "BodySeries": {
        "properties": {
          "azimuth_deg": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Azimuth Deg"
          },
          "elevation_deg": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Elevation Deg"
          },
          "horizon_deg": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Horizon Deg"
          }
        },
        "type": "object",
        "required": [
          "azimuth_deg",
          "elevation_deg",
          "horizon_deg"
        ],
        "title": "BodySeries",
        "description": "Columnar series aligned with `AnalysisResponse.times`."
      },
      "DataSourceOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "url"
        ],
        "title": "DataSourceOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version"
          },
          "lunar_core_version": {
            "type": "string",
            "title": "Lunar Core Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "api_version",
          "lunar_core_version"
        ],
        "title": "HealthResponse"
      },
      "HorizonMaskOut": {
        "properties": {
          "azimuth_deg": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Azimuth Deg"
          },
          "elevation_deg": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Elevation Deg"
          }
        },
        "type": "object",
        "required": [
          "azimuth_deg",
          "elevation_deg"
        ],
        "title": "HorizonMaskOut"
      },
      "MeridianOut": {
        "properties": {
          "longitude_deg": {
            "type": "number",
            "title": "Longitude Deg"
          },
          "x_m": {
            "type": "number",
            "title": "X M"
          },
          "y_m": {
            "type": "number",
            "title": "Y M"
          }
        },
        "type": "object",
        "required": [
          "longitude_deg",
          "x_m",
          "y_m"
        ],
        "title": "MeridianOut"
      },
      "MetricsOut": {
        "properties": {
          "sun_fraction": {
            "type": "number",
            "title": "Sun Fraction"
          },
          "earth_fraction": {
            "type": "number",
            "title": "Earth Fraction"
          },
          "longest_darkness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WindowOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "longest_earth_outage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WindowOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "sun_fraction",
          "earth_fraction",
          "longest_darkness",
          "longest_earth_outage"
        ],
        "title": "MetricsOut"
      },
      "ParallelOut": {
        "properties": {
          "latitude_deg": {
            "type": "number",
            "title": "Latitude Deg"
          },
          "radius_m": {
            "type": "number",
            "title": "Radius M"
          }
        },
        "type": "object",
        "required": [
          "latitude_deg",
          "radius_m"
        ],
        "title": "ParallelOut"
      },
      "PoleMapOut": {
        "properties": {
          "half_width_m": {
            "type": "number",
            "title": "Half Width M"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url"
          },
          "parallels": {
            "items": {
              "$ref": "#/components/schemas/ParallelOut"
            },
            "type": "array",
            "title": "Parallels"
          },
          "meridians": {
            "items": {
              "$ref": "#/components/schemas/MeridianOut"
            },
            "type": "array",
            "title": "Meridians"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "half_width_m",
          "image_url",
          "parallels",
          "meridians",
          "source_name",
          "source_url"
        ],
        "title": "PoleMapOut",
        "description": "Square map centered on the pole, spanning \u00b1half_width_m on both axes."
      },
      "SiteOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "latitude_deg": {
            "type": "number",
            "title": "Latitude Deg"
          },
          "longitude_deg": {
            "type": "number",
            "title": "Longitude Deg"
          },
          "origin": {
            "type": "string",
            "enum": [
              "sample",
              "official",
              "custom"
            ],
            "title": "Origin"
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "terrain_available": {
            "type": "boolean",
            "title": "Terrain Available"
          },
          "map_x_m": {
            "type": "number",
            "title": "Map X M"
          },
          "map_y_m": {
            "type": "number",
            "title": "Map Y M"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "latitude_deg",
          "longitude_deg",
          "origin",
          "note",
          "terrain_available",
          "map_x_m",
          "map_y_m"
        ],
        "title": "SiteOut"
      },
      "SiteResult": {
        "properties": {
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "site": {
            "$ref": "#/components/schemas/SiteOut"
          },
          "horizon_model": {
            "type": "string",
            "enum": [
              "terrain",
              "flat"
            ],
            "title": "Horizon Model"
          },
          "horizon_mask": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HorizonMaskOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricsOut"
          },
          "sun": {
            "$ref": "#/components/schemas/BodySeries"
          },
          "earth": {
            "$ref": "#/components/schemas/BodySeries"
          },
          "sun_windows": {
            "items": {
              "$ref": "#/components/schemas/WindowOut"
            },
            "type": "array",
            "title": "Sun Windows"
          },
          "earth_windows": {
            "items": {
              "$ref": "#/components/schemas/WindowOut"
            },
            "type": "array",
            "title": "Earth Windows"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "site",
          "horizon_model",
          "horizon_mask",
          "metrics",
          "sun",
          "earth",
          "sun_windows",
          "earth_windows"
        ],
        "title": "SiteResult"
      },
      "TerrainPatchOut": {
        "properties": {
          "site_id": {
            "type": "string",
            "title": "Site Id"
          },
          "half_width_m": {
            "type": "number",
            "title": "Half Width M"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "heights_m": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Heights M"
          },
          "site_ground_m": {
            "type": "number",
            "title": "Site Ground M"
          },
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "site_id",
          "half_width_m",
          "size",
          "heights_m",
          "site_ground_m",
          "source"
        ],
        "title": "TerrainPatchOut",
        "description": "Local terrain for the 3D view: heights (m) relative to the site's ground, with curvature.\n\nRow-major `size` by `size` values: row 0 is the north edge, column 0 the west edge, spanning\n\u00b1half_width_m east/north of the site."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WindowOut": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "duration_hours": {
            "type": "number",
            "title": "Duration Hours"
          },
          "visible": {
            "type": "boolean",
            "title": "Visible"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end",
          "duration_hours",
          "visible",
          "truncated"
        ],
        "title": "WindowOut"
      }
    }
  }
}
